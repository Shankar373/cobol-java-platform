       EXEC SQL
           SELECT POLICY_STATUS, COVER_LIMIT, DEDUCTIBLE
             INTO :WS-DB-POLICY-STATUS, :WS-DB-COVER-LIMIT,
                  :WS-DB-DEDUCTIBLE
             FROM INS_POLICY
            WHERE POLICY_ID = :WS-DB-POLICY-ID
       END-EXEC.

       EXEC SQL
           INSERT INTO INS_CLAIM_AUDIT
             (CLAIM_ID, POLICY_ID, STATUS, APPROVED_AMOUNT)
           VALUES (:WS-DB-CLAIM-ID, :WS-DB-POLICY-ID,
                   :WS-DB-STATUS, :WS-DB-APPROVED-AMOUNT)
       END-EXEC.
