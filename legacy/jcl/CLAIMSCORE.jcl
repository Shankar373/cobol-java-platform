//CLAIMS JOB (ACCT),'CLAIMSCORE EOD',CLASS=A,MSGCLASS=X
//* CLAIMSCORE INSURANCE CLAIMS NIGHTLY BATCH
//LOAD     EXEC PGM=CCLOAD01
//STEPLIB  DD DSN=CLAIMSCORE.LOADLIB,DISP=SHR
//PROCESS  EXEC PGM=CCPROC01
//CLAIMS   DD DSN=CLAIMSCORE.DAILY.CLAIMS,DISP=SHR
//AUDIT    DD DSN=CLAIMSCORE.CLAIM.AUDIT,DISP=MOD
//EXCEPT   DD DSN=CLAIMSCORE.CLAIM.EXCEPT,DISP=MOD
//REPORT   EXEC PGM=CCREPT01
//AUDITIN  DD DSN=CLAIMSCORE.CLAIM.AUDIT,DISP=SHR
//EXCIN    DD DSN=CLAIMSCORE.CLAIM.EXCEPT,DISP=SHR
//REPORT   DD DSN=CLAIMSCORE.EOD.REPORT,DISP=MOD
