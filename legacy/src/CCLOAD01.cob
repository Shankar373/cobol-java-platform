       IDENTIFICATION DIVISION.
       PROGRAM-ID. CCLOAD01.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT POLICY-MASTER ASSIGN TO "data/work/policy.dat"
               ORGANIZATION IS INDEXED ACCESS MODE IS DYNAMIC
               RECORD KEY IS POL-POLICY-ID FILE STATUS IS WS-POL-STATUS.
           SELECT CUSTOMER-MASTER ASSIGN TO "data/work/customer.dat"
               ORGANIZATION IS INDEXED ACCESS MODE IS DYNAMIC
               RECORD KEY IS CUS-CUSTOMER-ID FILE STATUS IS WS-CUS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD POLICY-MASTER.
       COPY "copybooks/CC-POLICY.cpy".
       FD CUSTOMER-MASTER.
       COPY "copybooks/CC-CUSTOMER.cpy".
       WORKING-STORAGE SECTION.
       01 WS-POL-STATUS PIC XX.
       01 WS-CUS-STATUS PIC XX.
       PROCEDURE DIVISION.
       MAIN-SECTION.
           OPEN OUTPUT POLICY-MASTER CUSTOMER-MASTER
           PERFORM LOAD-CUSTOMERS
           PERFORM LOAD-POLICIES
           CLOSE POLICY-MASTER CUSTOMER-MASTER
           MOVE 0 TO RETURN-CODE
           GOBACK.
       LOAD-CUSTOMERS.
           INITIALIZE CUSTOMER-RECORD
           MOVE "U00001" TO CUS-CUSTOMER-ID
           MOVE "GLOBAL MOTORS INDIA" TO CUS-NAME
           MOVE "A" TO CUS-STATUS MOVE "HYDERABAD" TO CUS-CITY
           MOVE "TS" TO CUS-STATE MOVE "L" TO CUS-RISK-LEVEL
           WRITE CUSTOMER-RECORD
           INITIALIZE CUSTOMER-RECORD
           MOVE "U00002" TO CUS-CUSTOMER-ID
           MOVE "SUNRISE RETAIL GROUP" TO CUS-NAME
           MOVE "A" TO CUS-STATUS MOVE "VIJAYAWADA" TO CUS-CITY
           MOVE "AP" TO CUS-STATE MOVE "M" TO CUS-RISK-LEVEL
           WRITE CUSTOMER-RECORD
           INITIALIZE CUSTOMER-RECORD
           MOVE "U00003" TO CUS-CUSTOMER-ID
           MOVE "ORBIT TECHNOLOGIES" TO CUS-NAME
           MOVE "A" TO CUS-STATUS MOVE "CHENNAI" TO CUS-CITY
           MOVE "TN" TO CUS-STATE MOVE "H" TO CUS-RISK-LEVEL
           WRITE CUSTOMER-RECORD.
       LOAD-POLICIES.
           INITIALIZE POLICY-RECORD
           MOVE "PL00000001" TO POL-POLICY-ID
           MOVE "U00001" TO POL-CUSTOMER-ID MOVE "MV" TO POL-TYPE
           MOVE "A" TO POL-STATUS MOVE "INR" TO POL-CURRENCY
           MOVE 500000.00 TO POL-COVER-LIMIT MOVE 25000.00 TO POL-DEDUCTIBLE
           MOVE 20260101 TO POL-EFFECTIVE-DATE MOVE 20261231 TO POL-EXPIRY-DATE
           WRITE POLICY-RECORD
           INITIALIZE POLICY-RECORD
           MOVE "PL00000002" TO POL-POLICY-ID
           MOVE "U00002" TO POL-CUSTOMER-ID MOVE "HE" TO POL-TYPE
           MOVE "A" TO POL-STATUS MOVE "INR" TO POL-CURRENCY
           MOVE 300000.00 TO POL-COVER-LIMIT MOVE 10000.00 TO POL-DEDUCTIBLE
           MOVE 20260101 TO POL-EFFECTIVE-DATE MOVE 20261231 TO POL-EXPIRY-DATE
           WRITE POLICY-RECORD
           INITIALIZE POLICY-RECORD
           MOVE "PL00000003" TO POL-POLICY-ID
           MOVE "U00003" TO POL-CUSTOMER-ID MOVE "PR" TO POL-TYPE
           MOVE "E" TO POL-STATUS MOVE "INR" TO POL-CURRENCY
           MOVE 150000.00 TO POL-COVER-LIMIT MOVE 15000.00 TO POL-DEDUCTIBLE
           MOVE 20250101 TO POL-EFFECTIVE-DATE MOVE 20251231 TO POL-EXPIRY-DATE
           WRITE POLICY-RECORD.
