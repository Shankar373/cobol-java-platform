       IDENTIFICATION DIVISION.
       PROGRAM-ID. CCPROC01.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CLAIM-IN ASSIGN TO "data/in/claims.dat"
               ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS WS-IN-STATUS.
           SELECT POLICY-MASTER ASSIGN TO "data/work/policy.dat"
               ORGANIZATION IS INDEXED ACCESS MODE IS DYNAMIC
               RECORD KEY IS POL-POLICY-ID FILE STATUS IS WS-POL-STATUS.
           SELECT AUDIT-OUT ASSIGN TO "data/out/claim-audit.dat"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT EXCEPTION-OUT ASSIGN TO "data/out/claim-exceptions.dat"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
        FD CLAIM-IN.
        01 CLAIM-LINE PIC X(152).
       FD POLICY-MASTER.
       COPY "copybooks/CC-POLICY.cpy".
       FD AUDIT-OUT.
       01 AUDIT-LINE PIC X(220).
       FD EXCEPTION-OUT.
       01 EXCEPTION-LINE PIC X(220).
       WORKING-STORAGE SECTION.
       COPY "copybooks/CC-CLAIM.cpy".
       COPY "copybooks/CC-CONSTANTS.cpy".
       01 WS-IN-STATUS PIC XX.
       01 WS-POL-STATUS PIC XX.
       01 WS-EOF PIC X VALUE "N".
       01 WS-RESULT PIC X.
       01 WS-ERROR-CODE PIC X(04).
       01 WS-ERROR-TEXT PIC X(80).
       01 WS-APPROVED-AMOUNT PIC S9(11)V99 COMP-3.
       01 WS-CLAIM-COUNT PIC 9(7) VALUE ZERO.
       01 WS-APPROVED-COUNT PIC 9(7) VALUE ZERO.
       01 WS-REJECTED-COUNT PIC 9(7) VALUE ZERO.
       01 WS-REVIEW-COUNT PIC 9(7) VALUE ZERO.
       01 WS-RAW.
           05 RAW-ID PIC X(12).
           05 RAW-DATE PIC X(08).
           05 RAW-TIME PIC X(06).
           05 RAW-POLICY PIC X(10).
           05 RAW-TYPE PIC X(02).
           05 RAW-CHANNEL PIC X(02).
           05 RAW-AMOUNT PIC X(12).
           05 RAW-DESC PIC X(40).
           05 RAW-REPORTER PIC X(20).
           05 RAW-FILLER PIC X(40).
       PROCEDURE DIVISION.
       MAIN-SECTION.
           OPEN INPUT CLAIM-IN
           OPEN I-O POLICY-MASTER
           OPEN OUTPUT AUDIT-OUT EXCEPTION-OUT
           PERFORM UNTIL WS-EOF = "Y"
               READ CLAIM-IN
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END PERFORM MAP-CLAIM PERFORM PROCESS-CLAIM
               END-READ
           END-PERFORM
           CLOSE CLAIM-IN POLICY-MASTER AUDIT-OUT EXCEPTION-OUT
           DISPLAY "CLAIMS PROCESSED: " WS-CLAIM-COUNT
           MOVE 0 TO RETURN-CODE GOBACK.
        MAP-CLAIM.
            MOVE CLAIM-LINE TO WS-RAW
            MOVE RAW-ID TO CLM-ID
           MOVE RAW-DATE TO CLM-DATE
           MOVE RAW-TIME TO CLM-TIME
           MOVE RAW-POLICY TO CLM-POLICY-ID
           MOVE RAW-TYPE TO CLM-TYPE
           MOVE RAW-CHANNEL TO CLM-CHANNEL
           MOVE RAW-AMOUNT TO CLM-LOSS-AMOUNT
           MOVE RAW-DESC TO CLM-DESCRIPTION
           MOVE RAW-REPORTER TO CLM-REPORTED-BY
           ADD 1 TO WS-CLAIM-COUNT.
       PROCESS-CLAIM.
           MOVE CC-VALID TO WS-RESULT
           MOVE SPACES TO WS-ERROR-CODE WS-ERROR-TEXT
           MOVE CLM-POLICY-ID TO POL-POLICY-ID
           READ POLICY-MASTER
           IF WS-POL-STATUS NOT = "00"
               MOVE CC-INVALID TO WS-RESULT
               MOVE "P001" TO WS-ERROR-CODE
               MOVE "POLICY NOT FOUND" TO WS-ERROR-TEXT
           ELSE
               PERFORM VALIDATE-POLICY
           END-IF
           IF WS-RESULT = CC-VALID PERFORM CALCULATE-SETTLEMENT END-IF
           IF WS-RESULT = CC-VALID OR WS-RESULT = CC-REVIEW
               PERFORM WRITE-AUDIT
           ELSE
               PERFORM WRITE-REJECTION
           END-IF.
       VALIDATE-POLICY.
           EVALUATE TRUE
               WHEN POL-STATUS NOT = "A"
                   MOVE CC-INVALID TO WS-RESULT
                   MOVE "P002" TO WS-ERROR-CODE
                   MOVE "POLICY INACTIVE OR EXPIRED" TO WS-ERROR-TEXT
               WHEN CLM-TYPE NOT = POL-TYPE
                   MOVE CC-INVALID TO WS-RESULT
                   MOVE "P003" TO WS-ERROR-CODE
                   MOVE "CLAIM TYPE NOT COVERED BY POLICY" TO WS-ERROR-TEXT
               WHEN OTHER CONTINUE
           END-EVALUATE.
       CALCULATE-SETTLEMENT.
           COMPUTE WS-APPROVED-AMOUNT = CLM-LOSS-AMOUNT - POL-DEDUCTIBLE
           IF WS-APPROVED-AMOUNT < 0 MOVE 0 TO WS-APPROVED-AMOUNT END-IF
           IF WS-APPROVED-AMOUNT > POL-COVER-LIMIT
               MOVE POL-COVER-LIMIT TO WS-APPROVED-AMOUNT
           END-IF
           IF WS-APPROVED-AMOUNT > 200000 MOVE CC-REVIEW TO WS-RESULT END-IF.
       WRITE-AUDIT.
           IF WS-RESULT = CC-REVIEW
               STRING CLM-ID "|" CLM-POLICY-ID "|MANUAL_REVIEW|"
                   WS-APPROVED-AMOUNT "|" CLM-DESCRIPTION INTO AUDIT-LINE
               WRITE AUDIT-LINE
               ADD 1 TO WS-REVIEW-COUNT
           ELSE
               STRING CLM-ID "|" CLM-POLICY-ID "|APPROVED|"
                   WS-APPROVED-AMOUNT "|" CLM-DESCRIPTION INTO AUDIT-LINE
               WRITE AUDIT-LINE
               ADD 1 TO WS-APPROVED-COUNT
           END-IF.
       WRITE-REJECTION.
           ADD 1 TO WS-REJECTED-COUNT
           STRING CLM-ID "|" CLM-POLICY-ID "|" WS-ERROR-CODE "|"
               WS-ERROR-TEXT "|" CLM-DESCRIPTION INTO EXCEPTION-LINE
           WRITE EXCEPTION-LINE.
