       IDENTIFICATION DIVISION.
       PROGRAM-ID. CCREPT01.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT AUDIT-IN ASSIGN TO "data/out/claim-audit.dat"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT EXCEPTION-IN ASSIGN TO "data/out/claim-exceptions.dat"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT REPORT-OUT ASSIGN TO "data/out/eod-claims-report.txt"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD AUDIT-IN.
       01 AUDIT-LINE PIC X(220).
       FD EXCEPTION-IN.
       01 EXCEPTION-LINE PIC X(220).
       FD REPORT-OUT.
       01 REPORT-LINE PIC X(160).
       WORKING-STORAGE SECTION.
       01 WS-AUDIT-EOF PIC X VALUE "N".
       01 WS-EXC-EOF PIC X VALUE "N".
       01 WS-AUDIT-COUNT PIC 9(7) VALUE ZERO.
       01 WS-EXCEPTION-COUNT PIC 9(7) VALUE ZERO.
       01 WS-REVIEW-COUNT PIC 9(7) VALUE ZERO.
       PROCEDURE DIVISION.
       MAIN-SECTION.
           OPEN INPUT AUDIT-IN EXCEPTION-IN
           OPEN OUTPUT REPORT-OUT
           PERFORM READ-AUDIT
           PERFORM READ-EXCEPTIONS
           PERFORM WRITE-REPORT
           CLOSE AUDIT-IN EXCEPTION-IN REPORT-OUT
           MOVE 0 TO RETURN-CODE GOBACK.
       READ-AUDIT.
           PERFORM UNTIL WS-AUDIT-EOF = "Y"
               READ AUDIT-IN
                   AT END MOVE "Y" TO WS-AUDIT-EOF
                   NOT AT END
                       ADD 1 TO WS-AUDIT-COUNT
                       IF AUDIT-LINE(25:13) = "MANUAL_REVIEW"
                           ADD 1 TO WS-REVIEW-COUNT
                       END-IF
               END-READ
           END-PERFORM.
       READ-EXCEPTIONS.
           PERFORM UNTIL WS-EXC-EOF = "Y"
               READ EXCEPTION-IN
                   AT END MOVE "Y" TO WS-EXC-EOF
                   NOT AT END ADD 1 TO WS-EXCEPTION-COUNT
               END-READ
           END-PERFORM.
       WRITE-REPORT.
           MOVE ALL "=" TO REPORT-LINE WRITE REPORT-LINE
           MOVE "CLAIMSCORE - END OF DAY CLAIMS REPORT" TO REPORT-LINE
           WRITE REPORT-LINE
           STRING "AUDIT RECORDS         : " WS-AUDIT-COUNT
               DELIMITED BY SIZE INTO REPORT-LINE WRITE REPORT-LINE
           STRING "EXCEPTIONS            : " WS-EXCEPTION-COUNT
               DELIMITED BY SIZE INTO REPORT-LINE WRITE REPORT-LINE
           STRING "MANUAL REVIEWS        : " WS-REVIEW-COUNT
               DELIMITED BY SIZE INTO REPORT-LINE WRITE REPORT-LINE
           MOVE "STATUS: CLAIMS BATCH COMPLETED" TO REPORT-LINE
           WRITE REPORT-LINE.
