       IDENTIFICATION DIVISION.
       PROGRAM-ID. PAYMAIN.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-POSITIVE   PIC S9(11)V99 COMP-3 VALUE 123456.78.
       01 WS-NEGATIVE   PIC S9(11)V99 COMP-3 VALUE -5000.00.
       01 WS-ZERO       PIC S9(11)V99 COMP-3 VALUE ZERO.
       01 WS-LARGE      PIC S9(11)V99 COMP-3 VALUE 99999999.99.
       01 WS-RESULT     PIC S9(11)V99 COMP-3.
       PROCEDURE DIVISION.
       MAIN-SECTION.
           DISPLAY "COMP-3 TEST STARTED"
           COMPUTE WS-RESULT = WS-POSITIVE + WS-NEGATIVE
           DISPLAY "POS + NEG = " WS-RESULT
           COMPUTE WS-RESULT = WS-ZERO + WS-POSITIVE
           DISPLAY "ZERO + POS = " WS-RESULT
           COMPUTE WS-RESULT = WS-LARGE + 0
           DISPLAY "LARGE = " WS-RESULT
           COMPUTE WS-RESULT = WS-NEGATIVE * -1
           DISPLAY "NEG NEGATED = " WS-RESULT
           DISPLAY "COMP-3 TEST COMPLETED"
           MOVE 0 TO RETURN-CODE
           GOBACK.
