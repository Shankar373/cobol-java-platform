       IDENTIFICATION DIVISION.
       PROGRAM-ID. COBPROG2.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IN-FILE ASSIGN TO OUTPUTDD.
           SELECT OUT-FILE ASSIGN TO REPORTDD.
       DATA DIVISION.
       FILE SECTION.
       FD  IN-FILE.
       01  IN-REC PIC X(80).
       FD  OUT-FILE.
       01  OUT-REC PIC X(80).
       WORKING-STORAGE SECTION.
       01  WS-EOF PIC X VALUE 'N'.
       PROCEDURE DIVISION.
           OPEN INPUT IN-FILE OUTPUT OUT-FILE.
           READ IN-FILE
               AT END MOVE 'Y' TO WS-EOF
           END-READ.
           MOVE SPACES TO OUT-REC.
           STRING "PROG2:" IN-REC DELIMITED BY SIZE INTO OUT-REC.
           WRITE OUT-REC.
           CLOSE IN-FILE OUT-FILE.
           MOVE 4 TO RETURN-CODE.
           GOBACK.
