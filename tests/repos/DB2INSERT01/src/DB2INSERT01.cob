       IDENTIFICATION DIVISION.
       PROGRAM-ID. DB2INS01.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  SQLCA-VARIABLES.
           05  SQLCODE    PIC S9(9) COMP.
           05  SQLSTATE   PIC X(5).
       01  WS-CUSTOMER.
           05  WS-CUST-ID   PIC S9(9) COMP VALUE 201.
           05  WS-CUST-NAME PIC X(20) VALUE "JOHN DOE".
       PROCEDURE DIVISION.
           EXEC SQL
               INSERT INTO CUSTOMER (CUST_ID, CUST_NAME)
               VALUES (:WS-CUST-ID, :WS-CUST-NAME)
           END-EXEC.
           DISPLAY "SQLCODE: " SQLCODE
           DISPLAY "SQLSTATE: " SQLSTATE
           GOBACK.
