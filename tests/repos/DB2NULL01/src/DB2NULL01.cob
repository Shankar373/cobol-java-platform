       IDENTIFICATION DIVISION.
       PROGRAM-ID. DB2NULL1.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  SQLCA-VARIABLES.
           05  SQLCODE    PIC S9(9) COMP.
           05  SQLSTATE   PIC X(5).
       01  WS-CUSTOMER.
           05  WS-CUST-ID   PIC S9(9) COMP VALUE 101.
           05  WS-CUST-NAME PIC X(20) VALUE SPACES.
           05  WS-CUST-IND  PIC S9(4) COMP VALUE 0.
       PROCEDURE DIVISION.
           EXEC SQL
               SELECT CUST_NAME
               INTO :WS-CUST-NAME :WS-CUST-IND
               FROM CUSTOMER
               WHERE CUST_ID = :WS-CUST-ID
           END-EXEC.
           DISPLAY "SQLCODE: " SQLCODE
           DISPLAY "SQLSTATE: " SQLSTATE
           DISPLAY "CUST-NAME: " WS-CUST-NAME
           DISPLAY "CUST-IND: " WS-CUST-IND
           GOBACK.
