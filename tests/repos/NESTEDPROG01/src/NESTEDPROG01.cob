       IDENTIFICATION DIVISION.
       PROGRAM-ID. NESTEDPROG01.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-GLOBAL-VAR PIC X(15) GLOBAL VALUE "GLOBAL_VAL_01".
       01  WS-LOCAL-VAR  PIC X(15) VALUE "LOCAL_PARENT".
       
       PROCEDURE DIVISION.
       MAIN-PARA.
           DISPLAY "PARENT START"
           DISPLAY "GLOBAL BEFORE: " WS-GLOBAL-VAR
           MOVE "UPDATED_GLOBAL" TO WS-GLOBAL-VAR
           CALL "NESTEDCHILD01" USING WS-LOCAL-VAR
           DISPLAY "GLOBAL AFTER: " WS-GLOBAL-VAR
           DISPLAY "LOCAL AFTER: " WS-LOCAL-VAR
           DISPLAY "PARENT END"
           GOBACK.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. NESTEDCHILD01.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CHILD-VAR  PIC X(15) VALUE "CHILD_VAL_02".
       LINKAGE SECTION.
       01  LS-PARENT-VAR PIC X(15).
       
       PROCEDURE DIVISION USING LS-PARENT-VAR.
       CHILD-PARA.
           DISPLAY "CHILD START"
           DISPLAY "GLOBAL IN CHILD: " WS-GLOBAL-VAR
           DISPLAY "LINKAGE IN CHILD: " LS-PARENT-VAR
           MOVE "CHILD_TOUCH" TO WS-GLOBAL-VAR
           MOVE "CHILD_LINK" TO LS-PARENT-VAR
           DISPLAY "CHILD END"
           GOBACK.
       END PROGRAM NESTEDCHILD01.
       END PROGRAM NESTEDPROG01.
