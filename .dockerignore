# Generated pipeline output — re-created on each run
target/
workspace/
scratch/
someout/
generated/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Git metadata (not needed in image)
.git/
.github/
.gemini/

# Local dev/audit files
*.log
audit/
# NOTE: execution/ is NOT ignored — cobol_migrate.py imports the execution
# package at runtime (baseline/execute/compare stages). Excluding it breaks
# containerized runs with ModuleNotFoundError.

# IDE
.vscode/
*.iml
