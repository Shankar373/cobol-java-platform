# Git ignore for cobj pipeline PoC
target/
!target/*.md
!target/manifest.json

# Exclude generated binaries and Java source
legacy/bin/
legacy/generated/
legacy/data/out/*
!legacy/data/out/.gitkeep
legacy/data/work/*
!legacy/data/work/.gitkeep
tests/out/
workspace/

# Python cache
__pycache__/
*.pyc

# Local config overrides
.env
.idea/
.vscode/

# Local tool config and runtime logs
.gemini/
ui-server.log
ui-server.err.log

# Compiled binaries and libraries
*.exe
*.so
*.dll
*.class
*.zip
*.sha256
*.dat

# Extra target folders and scratch
target_*/
scratch/
generated/

# Preprocessed shadow tree — regenerated deterministically by preprocess_cobol_for_cobj()
legacy/_preprocessed/

# Local test artifacts and logs
artifacts/
run_*.log
someout/
temp_testdisp*
